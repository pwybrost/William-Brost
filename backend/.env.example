# Copy this file to `.env` and fill in the values.

NODE_ENV=development
PORT=4000

# Neon: console.neon.tech -> your project -> "Connect" -> copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Long random string (at least 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-characters
SESSION_DAYS=7

# Where the frontend runs (comma-separate multiple origins).
CORS_ORIGIN=http://localhost:5173

# Local dev: false / lax. Production on HTTPS with frontend on another domain: true / none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set to true when running behind a reverse proxy / load balancer (Render, Railway, Nginx...).
TRUST_PROXY=false

# The OWNER account: the only account that can edit the site. Everyone else is a regular user.
# On every start the server promotes this email to owner (it keeps its current password)
# and demotes any other admin.
ADMIN_EMAIL=pwybrost@addu.edu.ph
# Optional. Only used to CREATE the owner account if nobody has signed up with ADMIN_EMAIL yet.
ADMIN_PASSWORD=
ADMIN_NAME=William Brost

# Max image upload size in megabytes.
MAX_UPLOAD_MB=5
